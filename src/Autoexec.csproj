<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Autoexec</RootNamespace>
    <AssemblyName>Autoexec</AssemblyName>
    <ApplicationIcon>Assets\autoexec.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Autoexec</Product>
    <Company>Mario Teck</Company>
    <Copyright>© 2026 Mario Teck</Copyright>
    <Description>Autoexec — prépare une clé d'installation de Windows ou de Linux</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- liste des disques et des pilotes (WMI) -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Resource Include="Assets\autoexec.ico" />
  </ItemGroup>

</Project>
